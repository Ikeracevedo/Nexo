BRUJULA_ENTORNO=local
BRUJULA_LOG_LEVEL=INFO
BRUJULA_ZONA_HORARIA=America/Bogota
# Nombre con el que el asistente se presenta (ayuda, tarjetas, prompts).
BOT_NOMBRE=Nexo

AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_REDIRECT_URI=http://localhost:8000/auth/callback

GEMINI_API_KEY=
# Cambiar de modelo cuesta esta variable, no un commit (ADR-006).
GEMINI_MODELO=gemini-2.5-flash
# Escoge el proveedor para respuestas, chat y deteccion: gemini o anthropic.
LLM_PROVEEDOR=gemini
ANTHROPIC_API_KEY=
ANTHROPIC_MODELO=claude-haiku-4-5
MONGODB_URI=

TEAMS_BOT_ID=
TEAMS_BOT_PASSWORD=
TEAMS_OAUTH_CONNECTION=

# URL pública sin /docs ni barra final.
BRUJULA_URL_PUBLICA=https://brujula-teams.duckdns.org

# Clave Fernet para cifrar refresh tokens antes de guardarlos en Mongo.
# Generarla una sola vez en el servidor; nunca subirla al repositorio.
BRUJULA_TOKEN_ENCRYPTION_KEY=
