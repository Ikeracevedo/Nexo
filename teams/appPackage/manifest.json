{
    "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.29/MicrosoftTeams.schema.json",
    "manifestVersion": "1.29",
    "version": "1.1.0",
    "id": "a3f7c9e2-8b41-4d6a-9e3f-1c5b7d2a6f04",
    "developer": {
        "name": "Proyecto en TIC 1, UPB",
        "websiteUrl": "https://github.com/Ikeracevedo/brujula-teams",
        "privacyUrl": "https://github.com/Ikeracevedo/brujula-teams/blob/main/docs/PRIVACIDAD.md",
        "termsOfUseUrl": "https://github.com/Ikeracevedo/brujula-teams/blob/main/docs/TERMINOS.md"
    },
    "icons": {
        "color": "color.png",
        "outline": "outline.png"
    },
    "name": {
        "short": "Brújula",
        "full": "Brújula"
    },
    "description": {
        "short": "Tus pendientes de Microsoft 365, unificados.",
        "full": "Brújula unifica los pendientes dispersos de Planner, To Do, Calendario y mensajes de Teams, y te dice qué tienes esta semana con enlace a la fuente exacta."
    },
    "accentColor": "#FFFFFF",
    "supportsChannelFeatures": "tier1",
    "bots": [
        {
            "botId": "772cbac6-54a2-49b6-b0c5-fb0a65f1671a",
            "scopes": [
                "personal",
                "team",
                "groupChat"
            ],
            "isNotificationOnly": false,
            "supportsTargetedMessages": false,
            "supportsCalling": false,
            "supportsVideo": false,
            "supportsFiles": false,
            "commandLists": [
                {
                    "scopes": [
                        "personal",
                        "team",
                        "groupChat"
                    ],
                    "triggers": [
                        "mention"
                    ],
                    "commands": [
                        {
                            "title": "semana",
                            "description": "Qué tienes en los próximos 7 días"
                        },
                        {
                            "title": "conectar",
                            "description": "Autoriza a Brújula a leer tu calendario real"
                        },
                        {
                            "title": "desconectar",
                            "description": "Revoca esa autorización"
                        },
                        {
                            "title": "estado",
                            "description": "Si tus datos son reales o de ejemplo, ahora mismo"
                        },
                        {
                            "title": "ayuda",
                            "description": "Ver qué sabe hacer Brújula"
                        }
                    ]
                }
            ]
        }
    ],
    "composeExtensions": [],
    "configurableTabs": [],
    "staticTabs": [],
    "permissions": [
        "identity",
        "messageTeamMembers"
    ],
    "validDomains": [
        "token.botframework.com"
    ]
}
