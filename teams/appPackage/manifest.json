{
    "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.29/MicrosoftTeams.schema.json",
    "manifestVersion": "1.29",
    "version": "1.3.0",
    "id": "a3f7c9e2-8b41-4d6a-9e3f-1c5b7d2a6f04",
    "developer": {
        "name": "Proyecto en TIC 1, UPB",
        "websiteUrl": "https://github.com/Ikeracevedo/Nexo",
        "privacyUrl": "https://github.com/Ikeracevedo/Nexo/blob/main/docs/PRIVACIDAD.md",
        "termsOfUseUrl": "https://github.com/Ikeracevedo/Nexo/blob/main/docs/TERMINOS.md"
    },
    "icons": {
        "color": "color.png",
        "outline": "outline.png"
    },
    "name": {
        "short": "Nexo",
        "full": "Nexo"
    },
    "description": {
        "short": "Tus pendientes de Microsoft 365, unificados.",
        "full": "Nexo unifica los pendientes dispersos de Planner, To Do, Calendario y mensajes de Teams, y te dice qué tienes esta semana con enlace a la fuente exacta."
    },
    "accentColor": "#FFFFFF",
    "supportsChannelFeatures": "tier1",
    "bots": [
        {
            "botId": "3e2297bb-fdfc-4f0f-99eb-9389332619f9",
            "scopes": [
                "personal",
                "team",
                "groupChat"
            ],
            "isNotificationOnly": false,
            "supportsTargetedMessages": false,
            "supportsCalling": false,
            "supportsVideo": false,
            "supportsFiles": true,
            "commandLists": [
                {
                    "scopes": [
                        "personal",
                        "team",
                        "groupChat"
                    ],
                    "triggers": [
                        "mention"
                    ],
                    "commands": [
                        {
                            "title": "semana",
                            "description": "Qué tienes en los próximos 7 días"
                        },
                        {
                            "title": "recuérdame",
                            "description": "Anota un pendiente propio"
                        },
                        {
                            "title": "vigilar",
                            "description": "Activa el análisis de tus chats para sugerir pendientes"
                        },
                        {
                            "title": "revisar",
                            "description": "Muestra los pendientes detectados en tus chats"
                        },
                        {
                            "title": "no vigilar",
                            "description": "Desactiva el análisis de tus conversaciones"
                        },
                        {
                            "title": "chat",
                            "description": "Haz una pregunta general a Nexo"
                        },
                        {
                            "title": "olvidar",
                            "description": "Borra la memoria de esta conversación"
                        },
                        {
                            "title": "conectar",
                            "description": "Autoriza a Nexo a leer tu calendario real"
                        },
                        {
                            "title": "desconectar",
                            "description": "Revoca esa autorización"
                        },
                        {
                            "title": "estado",
                            "description": "Si tus datos son reales o de ejemplo, ahora mismo"
                        },
                        {
                            "title": "ayuda",
                            "description": "Ver qué sabe hacer Nexo"
                        }
                    ]
                }
            ]
        }
    ],
    "composeExtensions": [],
    "configurableTabs": [],
    "staticTabs": [],
    "permissions": [
        "identity",
        "messageTeamMembers"
    ],
    "validDomains": [
        "token.botframework.com"
    ]
}
